# Supabase -> Settings -> API (these values belong to ONE customer's independent project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=macgpt-documents
# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_ADMIN_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Public application API authentication is issued from the super-admin console.
# Never put external app keys in NEXT_PUBLIC_* variables or website browser JS.
